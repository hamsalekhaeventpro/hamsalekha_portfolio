# =============================================================================
# Hamsalekha Event Production — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local and fill in the required values.
# NEVER commit .env.local or expose production secrets to git.
# =============================================================================

# Resend Transactional Email Delivery (Server-only)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Business Recipient Email (Server-only)
# The inbox where incoming client enquiries are delivered (e.g., info@hamsalekha.com)
ENQUIRY_TO_EMAIL=info@hamsalekha.com

# Verified Sender Email Address (Server-only)
# Must be sent from a domain verified in your Resend account (e.g. hamsalekha.com)
# For development testing without a custom domain, Resend allows: onboarding@resend.dev
ENQUIRY_FROM_EMAIL=Hamsalekha Event Production <enquiries@hamsalekha.com>

# Cloudflare Turnstile Anti-Spam Protection
# Turnstile Secret Key (Server-only, from Cloudflare dashboard)
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Turnstile Site Key (Public, exposed to client browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...

# Canonical Site URL (Public)
NEXT_PUBLIC_SITE_URL=https://hamsalekha-event-production.netlify.app
